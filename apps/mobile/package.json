    "build:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@card-trader/shared": "0.1.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
