# Optional. When unset the app derives the API host from the Metro dev server
# (works on emulators and on phones on the same Wi-Fi).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1

# Google Sign-In (optional; the Google button is hidden while unset, and always
# in Expo Go — it needs a development build).
# The OAuth "Web application" client ID from Google Cloud Console. The app asks
# Google for an ID token for this audience, so it must also be listed in the
# API's GOOGLE_CLIENT_IDS. Android additionally needs an "Android" client with
# the app's package name + signing SHA-1 in the same project (no value needed here).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# The OAuth "iOS" client ID. Required for the button to show on iOS; its
# reversed form also goes into app.json as the plugin's iosUrlScheme.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def.apps.googleusercontent.com

# Address used by Help Center → Contact Support (mailto:). Defaults to
# support@cardtrader.app when unset.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# RevenueCat public SDK keys (one per platform; identifiers, not secrets). Without them the
# unlock screen says purchases aren't available. See docs/PAYMENTS.md.
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
