{
  "expo": {
    "name": "Card Trader",
    "slug": "card-trader",
    "scheme": "cardtrader",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cardtrader.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.cardtrader.app",
      "adaptiveIcon": {
        "backgroundColor": "#EEF0FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Card Trader uses the camera to scan other collectors' QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Card Trader lets you choose photos of your cards and a profile picture.",
          "cameraPermission": "Card Trader uses the camera to scan other collectors' QR codes.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ]
  }
}
