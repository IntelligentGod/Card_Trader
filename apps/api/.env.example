# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
# 127.0.0.1 when a reverse proxy on this machine is the only way in.
HOST=0.0.0.0

# Local embedded Postgres (npm run db:start) listens on 5433 by default.
# With docker compose use port 5432.
DATABASE_URL=postgresql://cardtrader:cardtrader@localhost:5433/cardtrader?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Base URL the mobile app uses to load uploaded media (use your LAN IP for a device).
PUBLIC_BASE_URL=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

SWAGGER_ENABLED=true
# Set to 1 when running behind a reverse proxy so rate limiting sees client IPs.
TRUST_PROXY=0

# Browser origins allowed to call the API (comma-separated): the admin website.
CORS_ORIGINS=http://localhost:5173

# Comma-separated provider codes. MOCK is safe for development.
# EBAY requires approved access to eBay's Marketplace Insights API.
PRICING_PROVIDERS=MOCK
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_REQUESTS_PER_MINUTE=30

PRICE_REFRESH_BATCH_SIZE=25

# ── Super admin (created on first start if this email has no account) ──
# Never commit the password. Remove it from the environment after the first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=

# ── Google / Apple sign-in: allowed token audiences (comma-separated) ──
# Google: the Web client id the app passes to Google Sign-In (plus iOS/Android client ids).
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle id, com.cardtrader.app
APPLE_CLIENT_IDS=

# ── Two-factor authentication ──
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later disables every user's 2FA (their secrets can no longer be read).
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Card Trader

# ── One-time unlock ($4.99, Google Play / App Store through RevenueCat) ──
# Keep false until the products exist in both stores and RevenueCat; everyone has full access meanwhile.
PAYWALL_ENABLED=false
# RevenueCat → Project → API keys → Secret key (sk_…). Lets the server confirm a purchase.
REVENUECAT_SECRET_KEY=
# Any long random string; paste the same value as the webhook's Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat entitlement identifier attached to the product.
PURCHASE_ENTITLEMENT_ID=full_access
