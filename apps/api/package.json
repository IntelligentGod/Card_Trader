{
  "name": "@card-trader/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "ts-node-dev --respawn --transpile-only --exit-child src/main.ts",
    "worker:dev": "ts-node-dev --respawn --transpile-only --exit-child src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:start": "node scripts/local-postgres.mjs",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "admin:grant": "node scripts/set-admin.mjs grant",
    "admin:super": "node scripts/set-admin.mjs super",
    "admin:revoke": "node scripts/set-admin.mjs revoke",
    "admin:list": "node scripts/set-admin.mjs list",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed/seed.ts"
  },
  "dependencies": {
    "@card-trader/shared": "0.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "nodemailer": "^10.0.13",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
